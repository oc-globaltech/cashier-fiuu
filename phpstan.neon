includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    # A dependency update that fixes a baselined error must not fail the build.
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
        # Uses Billable, so the customer traits are analysed too.
        - tests/TestCase.php
    databaseMigrationsPath:
        - database/migrations
